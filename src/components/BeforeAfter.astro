---
interface Props {
  beforeSrc: string;
  afterSrc: string;
  beforeAlt: string;
  afterAlt: string;
  caption?: string;
}

const { beforeSrc, afterSrc, beforeAlt, afterAlt, caption } = Astro.props;
const uid = `ba-${Math.random().toString(36).slice(2, 9)}`;
---

<figure class="reveal mx-auto max-w-lg">
  <div
    class="before-after relative aspect-[4/5] overflow-hidden rounded-2xl bg-powder select-none"
    data-ba={uid}
  >
    <img
      src={afterSrc}
      alt={afterAlt}
      class="absolute inset-0 h-full w-full object-cover"
      width="800"
      height="1000"
      loading="lazy"
    />
    <div class="ba-before absolute inset-0 w-1/2 overflow-hidden" data-before>
      <img
        src={beforeSrc}
        alt={beforeAlt}
        class="absolute inset-0 h-full max-w-none object-cover"
        style={`width: 200%; max-width: none;`}
        width="800"
        height="1000"
        loading="lazy"
      />
    </div>
    <div
      class="ba-handle absolute inset-y-0 left-1/2 z-10 w-0.5 -translate-x-1/2 bg-white shadow"
      data-handle
    >
      <span
        class="absolute left-1/2 top-1/2 flex h-10 w-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-powder bg-white text-xs font-medium text-graphite shadow"
        aria-hidden="true"
      >
        ↔
      </span>
    </div>
    <input
      type="range"
      min="0"
      max="100"
      value="50"
      class="absolute inset-0 z-20 h-full w-full cursor-ew-resize opacity-0"
      aria-label="Сравнение до и после"
      data-range
    />
    <span class="pointer-events-none absolute left-3 top-3 rounded-full bg-milk/90 px-3 py-1 text-xs font-medium">До</span>
    <span class="pointer-events-none absolute right-3 top-3 rounded-full bg-milk/90 px-3 py-1 text-xs font-medium">После</span>
  </div>
  {caption && <figcaption class="mt-3 text-center text-sm text-taupe">{caption}</figcaption>}
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((root) => {
    const before = root.querySelector<HTMLElement>('[data-before]');
    const handle = root.querySelector<HTMLElement>('[data-handle]');
    const range = root.querySelector<HTMLInputElement>('[data-range]');
    const img = before?.querySelector('img');
    const set = (v: number) => {
      if (before) before.style.width = `${v}%`;
      if (handle) handle.style.left = `${v}%`;
      if (img) img.style.width = `${10000 / Math.max(v, 1)}%`;
    };
    range?.addEventListener('input', () => set(Number(range.value)));
    set(50);
  });
</script>
