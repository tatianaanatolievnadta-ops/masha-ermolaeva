---
import { site } from '@/config/site';
---

<div class="maker-badge" aria-label={`Сайт сделала ${site.makerName}`}>
  <a href={site.makerUrl} target="_blank" rel="noopener noreferrer">
    <span class="star" aria-hidden="true">★</span>
    <span>Сайт сделала {site.makerName}</span>
    <span class="arrow" aria-hidden="true">→</span>
  </a>
</div>

<style>
  .maker-badge {
    position: fixed;
    left: max(0.7rem, env(safe-area-inset-left));
    bottom: max(0.7rem, env(safe-area-inset-bottom));
    z-index: 80;
    max-width: min(92vw, 320px);
  }

  .maker-badge a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.75rem 0.55rem 0.65rem;
    border-radius: 999px;
    border: 1px solid rgba(176, 141, 87, 0.45);
    background: rgba(46, 42, 39, 0.92);
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.22);
    color: #e0c08a;
    font-family: Manrope, system-ui, sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1.2;
  }

  .maker-badge a:hover {
    border-color: #b08d57;
    color: #fff;
  }

  .maker-badge .star {
    color: #e0c08a;
    font-size: 0.85rem;
  }

  .maker-badge .arrow {
    opacity: 0.85;
  }

  @media (max-width: 860px) {
    .maker-badge {
      bottom: max(4.5rem, env(safe-area-inset-bottom));
    }
  }
</style>
