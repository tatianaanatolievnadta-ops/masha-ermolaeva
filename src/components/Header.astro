---
import { site } from '@/config/site';
import { path } from '@/lib/paths';
---

<header
  class="sticky top-0 z-40 border-b border-powder/80 bg-milk/95 backdrop-blur-md"
>
  <div class="container-page flex h-18 items-center justify-between gap-4 py-3 md:h-24 md:py-0">
    <a href={path('/')} class="flex min-w-0 items-center gap-2.5 md:gap-4" aria-label={`${site.name} — ${site.slogan}`}>
      <!-- Временно два варианта — Мария выберет, какой оставить -->
      <span class="flex shrink-0 items-end gap-2">
        <span class="flex flex-col items-center gap-0.5">
          <img
            src={path('/images/logo-masha-massage-v2.jpg')}
            alt="Вариант 1 — массаж"
            width="80"
            height="80"
            class="h-14 w-14 rounded-full border border-caramel/40 bg-milk shadow-sm md:h-20 md:w-20"
          />
          <span class="hidden text-[9px] font-medium tracking-wide text-taupe uppercase sm:block">1 · массаж</span>
        </span>
        <span class="flex flex-col items-center gap-0.5">
          <img
            src={path('/images/logo-masha-hands-heart.jpg')}
            alt="Вариант 2 — руки и сердце"
            width="112"
            height="112"
            class="h-[4.5rem] w-[4.5rem] rotate-90 rounded-full border border-caramel/40 bg-milk object-cover shadow-sm md:h-28 md:w-28"
          />
          <span class="hidden text-[9px] font-medium tracking-wide text-taupe uppercase sm:block">2 · сердце</span>
        </span>
      </span>
      <span class="min-w-0">
        <span class="font-display block text-xl font-semibold tracking-tight md:text-3xl">
          Мария Ермолаева
        </span>
        <span class="mt-0.5 block font-sans text-[11px] font-medium tracking-[0.14em] text-gold uppercase md:text-xs">
          {site.slogan}
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 xl:flex" aria-label="Основное меню">
      {
        site.nav.map((item) => (
          <a
            href={path(item.href)}
            class="text-sm font-medium text-taupe transition-colors hover:text-graphite"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={site.phoneHref}
        class="hidden text-sm font-medium text-graphite lg:inline"
      >
        {site.phone}
      </a>
      <div class="hidden items-center gap-2 sm:flex" aria-label="Мессенджеры">
        <a href={site.social.max} class="text-xs font-medium text-taupe hover:text-gold" target="_blank" rel="noopener noreferrer">MAX</a>
        <a href={site.social.telegram} class="text-xs font-medium text-taupe hover:text-gold" target="_blank" rel="noopener noreferrer">TG</a>
        <a href={site.social.vk} class="text-xs font-medium text-taupe hover:text-gold" target="_blank" rel="noopener noreferrer">VK</a>
      </div>
      <a href={path('/#zapis')} class="btn-primary !h-11 !px-5 text-sm">Записаться</a>
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-powder xl:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Открыть меню"
      >
        <span class="sr-only">Меню</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-powder bg-milk xl:hidden">
    <nav class="container-page flex flex-col gap-1 py-4" aria-label="Мобильное меню">
      {
        site.nav.map((item) => (
          <a href={path(item.href)} class="rounded-lg px-3 py-3 text-base font-medium hover:bg-powder/50">
            {item.label}
          </a>
        ))
      }
      <a href={site.phoneHref} class="rounded-lg px-3 py-3 text-base font-medium text-gold">
        {site.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
