---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '@/config/site';
import { breadcrumbSchema } from '@/lib/schema';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={`Блог — косметология и массаж | Мария ${site.lastName}`}
  description="Статьи о ботулинотерапии, биоревитализации, пилингах и массаже — простым языком."
  jsonLd={breadcrumbSchema([
    { name: 'Главная', path: '/' },
    { name: 'Блог', path: '/blog/' },
  ])}
>
  <section class="section">
    <div class="container-page max-w-3xl">
      <h1>Блог</h1>
      <p class="mt-4 text-taupe">Полезное без латыни — и со ссылкой на запись в конце каждой статьи.</p>
      <ul class="mt-12 space-y-8">
        {
          posts.map((p) => (
            <li class="border-b border-powder pb-8">
              <a href={`/blog/${p.slug}/`} class="group">
                <h2 class="font-display text-3xl group-hover:text-gold">{p.data.title}</h2>
                <p class="mt-2 text-taupe">{p.data.description}</p>
                <time class="mt-3 block text-sm text-caramel" datetime={p.data.pubDate.toISOString()}>
                  {p.data.pubDate.toLocaleDateString('ru-RU')}
                </time>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
