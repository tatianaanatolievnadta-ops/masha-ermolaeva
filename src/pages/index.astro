---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import Accordion from '@/components/Accordion.astro';
import BeforeAfter from '@/components/BeforeAfter.astro';
import BookingForm from '@/components/BookingForm.astro';
import { site, titleHome, descriptionTemplate } from '@/config/site';
import { beautySalonSchema, faqSchema } from '@/lib/schema';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order
);
const face = services.filter((s) => s.data.category === 'face');
const body = services.filter((s) => s.data.category === 'body');
const reviews = await getCollection('reviews');
const serviceOptions = services.map((s) => ({
  slug: s.slug,
  title: s.data.title,
}));

const requests = [
  { title: 'Уставший взгляд', text: 'Открываем взгляд бережно, без «маски»' },
  { title: 'Морщины', text: 'Работаем по плану, а не «по прайсу»' },
  { title: 'Тусклая кожа', text: 'Сияние и качество кожи протоколом' },
  { title: 'Боль в шее', text: 'Лечебный массаж под сидячую работу' },
  { title: 'Бессонница', text: 'Снимаем зажимы — легче засыпать' },
  { title: 'Целлюлит', text: 'Курс с понятными сроками и ожиданиями' },
];

const steps = [
  {
    n: '01',
    title: 'Знакомимся',
    text: 'Подробно собираю анамнез — это главная часть моей работы.',
  },
  {
    n: '02',
    title: 'Ставим задачи',
    text: 'Что делаем, как и в каком порядке.',
  },
  {
    n: '03',
    title: 'Процедуры',
    text: 'Тонкие иглы, бережные техники, результат видно сразу.',
  },
  {
    n: '04',
    title: 'Домашний уход',
    text: 'Подбираю средства под вашу кожу, чтобы эффект держался дольше.',
  },
];

const faq = [
  {
    q: 'Больно ли?',
    a: 'Дискомфорт обычно короткий. На консультации честно рассказываю об ощущениях конкретной процедуры.',
  },
  {
    q: 'Когда будет виден результат?',
    a: 'Зависит от услуги: массаж — часто сразу, ботулинотерапия — до 14 дней, курсы — нарастающе.',
  },
  {
    q: 'Сколько держится эффект?',
    a: 'От нескольких недель до месяцев. Всё проговариваем до старта и закрепляем уходом.',
  },
  {
    q: 'Будет ли лицо неестественным?',
    a: 'Моя задача — сохранить вас узнаваемой. Без эффекта «переделанного» лица.',
  },
  {
    q: 'Какие противопоказания?',
    a: 'Список зависит от процедуры. На анамнезе выясняем всё важное — иногда я говорю «нет».',
  },
  {
    q: 'Как подготовиться к процедуре?',
    a: 'Памятку присылаю после записи. Базово — без активного воспаления и с заполненным анамнезом.',
  },
  {
    q: 'Можно ли совмещать массаж и косметологию?',
    a: 'Да, это как раз мой формат: лицо + тело в одном плане.',
  },
  {
    q: 'Как перенести запись?',
    a: 'Напишите заранее в MAX, Telegram или VK — правила переноса сообщу при записи.',
  },
];

const title = titleHome();
const description = descriptionTemplate(
  'Свежее лицо и лёгкое тело по плану. Косметолог и массажист в одних руках.'
);
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[beautySalonSchema(), faqSchema(faq)]}
>
  <!-- 2. Hero -->
  <section class="section relative overflow-hidden">
    <div class="container-page grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="reveal">
        <p class="mb-4 text-sm font-medium uppercase tracking-[0.2em] text-caramel">
          {site.slogan}
        </p>
        <h1>
          Косметолог и массажист в {site.district}: свежее лицо и лёгкое тело по плану
        </h1>
        <p class="mt-6 max-w-xl text-taupe">
          Я — Мария. Помогаю женщинам после 35 увидеть свою красоту без эффекта
          «переделанного» лица и вернуть телу лёгкость. Сначала анамнез и план —
          потом результат, который держится.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#zapis" class="btn-primary">Записаться на консультацию</a>
          <a href="#uslugi" class="btn-secondary">Посмотреть услуги</a>
        </div>
        <ul class="mt-10 grid gap-4 sm:grid-cols-3">
          <li class="rounded-2xl bg-powder/50 p-4">
            <p class="font-display text-3xl text-gold">{site.yearsPractice}</p>
            <p class="mt-1 text-sm text-taupe">лет практики</p>
          </li>
          <li class="rounded-2xl bg-powder/50 p-4">
            <p class="font-display text-3xl text-gold">{site.clientsCount}+</p>
            <p class="mt-1 text-sm text-taupe">постоянных клиенток</p>
          </li>
          <li class="rounded-2xl bg-powder/50 p-4">
            <p class="font-display text-xl leading-tight text-gold">Официальные</p>
            <p class="mt-1 text-sm text-taupe">дистрибьюторы препаратов</p>
          </li>
        </ul>
      </div>
      <div class="reveal relative">
        <div
          class="hero-photo aspect-[4/5] overflow-hidden rounded-[2rem] bg-powder"
          data-parallax
        >
          <img
            src="/images/portrait-placeholder.svg"
            alt={`Косметолог Мария ${site.lastName}, портрет`}
            width="800"
            height="1000"
            class="h-full w-full object-cover"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Requests -->
  <section class="section bg-powder/30">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <h2>С чем ко мне приходят</h2>
        <p class="mt-4 text-taupe">Шесть самых частых запросов — и как я с ними работаю</p>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          requests.map((r) => (
            <article class="reveal rounded-3xl bg-milk p-6 shadow-sm">
              <h3 class="font-display text-2xl">{r.title}</h3>
              <p class="mt-2 text-sm text-taupe">{r.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Services -->
  <section id="uslugi" class="section">
    <div class="container-page">
      <div class="reveal flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
        <div>
          <h2>Услуги</h2>
          <p class="mt-3 max-w-xl text-taupe">
            Лицо и тело в одном плане — не нужно искать трёх специалистов
          </p>
        </div>
        <div class="flex gap-2" role="tablist" aria-label="Категории услуг">
          <button
            type="button"
            class="tab-btn btn-primary !h-11 text-sm"
            data-tab="face"
            aria-selected="true">Лицо</button
          >
          <button
            type="button"
            class="tab-btn btn-secondary !h-11 text-sm"
            data-tab="body"
            aria-selected="false">Тело</button
          >
        </div>
      </div>

      <div id="tab-face" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          face.map((s) => (
            <ServiceCard
              href={`/${s.slug}/`}
              title={s.data.title}
              shortResult={s.data.shortResult}
              priceFrom={s.data.priceFrom}
              imageAlt={`${s.data.title} — ${s.data.shortResult}`}
            />
          ))
        }
      </div>
      <div id="tab-body" class="mt-10 hidden grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          body.map((s) => (
            <ServiceCard
              href={`/${s.slug}/`}
              title={s.data.title}
              shortResult={s.data.shortResult}
              priceFrom={s.data.priceFrom}
              imageAlt={`${s.data.title} — ${s.data.shortResult}`}
            />
          ))
        }
      </div>
      <p class="mt-8 text-center">
        <a href="/programma-krasota-po-planu/" class="text-gold hover:underline">
          Годовая программа «Красота по плану» →
        </a>
      </p>
    </div>
  </section>

  <!-- 5. How I work -->
  <section class="section bg-powder/30">
    <div class="container-page">
      <h2 class="reveal">Как я работаю</h2>
      <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((s) => (
            <li class="reveal rounded-3xl bg-milk p-6">
              <span class="font-display text-4xl text-caramel">{s.n}</span>
              <h3 class="mt-3 font-display text-2xl">{s.title}</h3>
              <p class="mt-2 text-sm text-taupe">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 6. Before / after -->
  <section class="section">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <h2>До и после</h2>
        <p class="mt-4 text-taupe">
          Только с письменного согласия клиентов. Замените фото на реальные.
        </p>
      </div>
      <div class="mt-12 grid gap-10 lg:grid-cols-2">
        <BeforeAfter
          beforeSrc="/images/placeholder-before.svg"
          afterSrc="/images/placeholder-after.svg"
          beforeAlt="До процедуры — пример (замените на фото клиентки с согласием)"
          afterAlt="После процедуры — пример (замените на фото клиентки с согласием)"
          caption="Пример слайдера. Загрузите реальные фото."
        />
        <BeforeAfter
          beforeSrc="/images/placeholder-before.svg"
          afterSrc="/images/placeholder-after.svg"
          beforeAlt="До массажа — пример"
          afterAlt="После массажа — пример"
          caption="Второй кейс — после согласия клиента."
        />
      </div>
    </div>
  </section>

  <!-- 7. About -->
  <section id="obo-mne" class="section bg-powder/30">
    <div class="container-page grid items-center gap-10 lg:grid-cols-2">
      <div class="reveal aspect-[4/5] overflow-hidden rounded-[2rem] bg-powder">
        <img
          src="/images/portrait-placeholder.svg"
          alt="Мария за работой"
          width="800"
          height="1000"
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="reveal">
        <h2>Обо мне</h2>
        <p class="mt-6 text-taupe">
          Я обожаю момент, когда клиентка смотрит в зеркало и говорит: «А я и не
          знала, что так можно». Работаю с лицом и телом, потому что красота —
          это не только кожа, но и лёгкость в спине, и спокойный сон. Ко мне
          приезжают из разных районов, и почти все возвращаются.
        </p>
        <a href="/obo-mne/" class="btn-ghost mt-8">Дипломы и история</a>
      </div>
    </div>
  </section>

  <!-- 8. Year program -->
  <section class="section">
    <div class="container-page">
      <div class="reveal overflow-hidden rounded-[2rem] bg-graphite px-8 py-12 text-milk md:px-14 md:py-16">
        <p class="text-sm uppercase tracking-[0.2em] text-caramel">Премиум</p>
        <h2 class="mt-3 text-milk">Годовая программа «Красота по плану»</h2>
        <p class="mt-4 max-w-2xl text-powder">
          Процедуры по графику, массаж и домашний уход — один протокол на год.
          Для тех, кто хочет предсказуемый результат, а не разовые визиты.
        </p>
        <a href="/programma-krasota-po-planu/" class="btn-primary mt-8">Подробнее о программе</a>
      </div>
    </div>
  </section>

  <!-- 9. Reviews -->
  <section class="section bg-powder/30">
    <div class="container-page">
      <div class="reveal flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <h2>Отзывы</h2>
        <a
          href={site.social.yandexMaps}
          class="text-sm text-gold hover:underline"
          target="_blank"
          rel="noopener noreferrer">Смотреть на Яндекс Картах →</a
        >
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          reviews.map((r) => (
            <blockquote class="reveal rounded-3xl bg-milk p-6">
              <p class="text-taupe">«{r.data.text}»</p>
              <footer class="mt-4 text-sm font-medium">
                — {r.data.name}
                {r.data.service && (
                  <span class="block font-normal text-taupe">{r.data.service}</span>
                )}
              </footer>
            </blockquote>
          ))
        }
      </div>
      <p class="mt-8 text-center">
        <a href="/otzyvy/" class="text-gold hover:underline">Все отзывы →</a>
      </p>
    </div>
  </section>

  <!-- 10. Safety -->
  <section class="section">
    <div class="container-page max-w-3xl">
      <h2 class="reveal">Безопасность</h2>
      <p class="reveal mt-6 text-taupe">
        Использую только препараты, которые продаются косметологам после обучения
        через официальных дистрибьюторов, — никаких маркетплейсов. Испанская и
        израильская косметика, протоколы под каждую кожу. Если процедура вам не
        подходит — честно скажу.
      </p>
      <p class="reveal mt-6 text-sm font-medium text-graphite">{site.disclaimer}</p>
    </div>
  </section>

  <!-- 11. FAQ -->
  <section class="section bg-powder/30">
    <div class="container-page max-w-3xl">
      <h2 class="reveal mb-10">Частые вопросы</h2>
      <div class="reveal">
        <Accordion items={faq} id="faq-home" />
      </div>
    </div>
  </section>

  <!-- 12. Booking + map -->
  <section id="zapis" class="section">
    <div class="container-page grid gap-12 lg:grid-cols-2">
      <div class="reveal">
        <h2>Запись</h2>
        <p class="mt-4 text-taupe">
          Запишитесь на консультацию — разберём вашу кожу и составим план. Ни к
          чему не обязывает.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={site.phoneHref} class="btn-secondary !h-11 text-sm">Позвонить</a>
          <a href={site.social.max} class="btn-ghost !h-11 text-sm" target="_blank" rel="noopener noreferrer">MAX</a>
          <a href={site.social.telegram} class="btn-ghost !h-11 text-sm" target="_blank" rel="noopener noreferrer">Telegram</a>
          <a href={site.social.vk} class="btn-ghost !h-11 text-sm" target="_blank" rel="noopener noreferrer">VK</a>
        </div>
        <div class="mt-8">
          <BookingForm services={serviceOptions} />
        </div>
      </div>
      <div class="reveal">
        <h3 class="font-display text-2xl">Адрес</h3>
        <p class="mt-3 text-taupe">{site.addressFull}</p>
        <p class="mt-2 text-sm text-taupe">{site.schedule}</p>
        <div class="mt-6 flex aspect-[4/3] items-center justify-center rounded-3xl bg-powder text-sm text-taupe">
          Карта: вставьте виджет Яндекс Карт после заполнения адреса
        </div>
        <a href="/kontakty/" class="mt-4 inline-block text-sm text-gold hover:underline">
          Как добраться →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const face = document.getElementById('tab-face');
  const body = document.getElementById('tab-body');
  tabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tab = btn.dataset.tab;
      tabs.forEach((b) => {
        const on = b === btn;
        b.setAttribute('aria-selected', String(on));
        b.classList.toggle('btn-primary', on);
        b.classList.toggle('btn-secondary', !on);
      });
      face?.classList.toggle('hidden', tab !== 'face');
      body?.classList.toggle('hidden', tab !== 'body');
    });
  });

  const photo = document.querySelector<HTMLElement>('[data-parallax]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (photo && !reduce) {
    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY * 0.06;
        photo.style.transform = `translateY(${y}px)`;
      },
      { passive: true }
    );
  }
</script>
