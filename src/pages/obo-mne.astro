---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import { personSchema, breadcrumbSchema } from '@/lib/schema';
import { path } from '@/lib/paths';
---

<BaseLayout
  title={`Обо мне — Мария ${site.lastName}`}
  description={`Подход Марии ${site.lastName}: уход за лицом и телом в уютном кабинете. ${site.city}.`}
  jsonLd={[
    personSchema(),
    breadcrumbSchema([
      { name: 'Главная', path: '/' },
      { name: 'Обо мне', path: '/obo-mne/' },
    ]),
  ]}
>
  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-2">
      <div>
        <h1>Обо мне</h1>
        <p class="mt-6 text-taupe">
          Я обожаю момент, когда клиентка смотрит в зеркало и говорит: «А я и не
          знала, что так можно». Работаю с лицом и телом: свежая кожа, лёгкость в
          спине, спокойнее голова. Ко мне возвращаются — и часто приезжают из
          разных районов города.
        </p>
        <p class="mt-4 text-taupe">
          В кабинете спокойно и по делу: сначала разговор, потом то, что реально
          нужно вам. Обучение и опыт подтверждаю при личной встрече — на сайте
          дипломы не выкладываю.
        </p>
        <p class="mt-4 text-taupe">{site.tagline}</p>
        <a href={path('/#zapis')} class="btn-primary mt-8">Записаться</a>
      </div>
      <div class="aspect-[4/5] overflow-hidden rounded-[2rem] bg-powder">
        <img
          src={path(site.photos.about)}
          alt={site.photos.aboutAlt}
          width="800"
          height="1000"
          class="h-full w-full object-cover object-top"
        />
      </div>
    </div>
  </section>
</BaseLayout>
